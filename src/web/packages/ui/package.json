{
  "name": "@petlibre/ui",
  "private": true,
  "type": "module",
  "description": "The page base and Svelte components shared by the petlibre web frontends, over the Midnight tokens and bits-ui",
  "exports": {
    ".": "./src/index.ts",
    "./base.css": "./src/base.css"
  },
  "svelte": "./src/index.ts",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@petlibre/tokens": "workspace:*",
    "bits-ui": "2.19.5"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
