#!/usr/bin/env bash
# Serve the read-only bench page for this checkout, attached to whatever is
# running: a bench command or integration run in another terminal, and a
# petlibre-local serve if one is up. Builds the page and binary when needed.
#
#   src/scripts/dev-dashboard                     # http://127.0.0.1:8780/
#   src/scripts/dev-dashboard --ui-port 8781
#   src/scripts/dev-dashboard --listen 100.x.y.z  # a Tailscale address, for a phone
#
# Extra arguments go to petlibre-bench. It never touches relays, the UART or
# flash; Ctrl+C stops it.
set -euo pipefail

# The checkout root, two levels above this script.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

dist="src/web/apps/bench/dist/index.html"
# Rebuild the page when it is missing or any web source is newer than it.
if [[ ! -f "$dist" ]] || [[ -n "$(find src/web -path '*/node_modules' -prune -o -path '*/dist' -prune -o -type f -newer "$dist" -print -quit)" ]]; then
  make ui
fi

# Cargo skips the build when nothing changed.
cargo build --locked --release -p petlibre-bench --features ui

exec ./target/release/petlibre-bench --root "$root" --ui "$@"
