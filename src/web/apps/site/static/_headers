# Cloudflare static-asset response headers (docs/web/site.md). The page ships no
# script and loads nothing from another origin, so the policy allows only
# its own styles, fonts and images.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
